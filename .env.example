# Kalshi RSA API key auth (no 2FA needed)
# Generate: openssl genrsa -out kalshi_private.pem 2048
# Upload public key at: kalshi.com → Settings → API Keys
KALSHI_API_KEY_ID=your_key_id_from_kalshi
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Risk settings
MIN_EDGE=0.04           # 4% minimum guaranteed profit per trade
MAX_TRADE_USDC=25       # max USDC per trade leg
MAX_OPEN_POSITIONS=8    # max arb positions per scan
SCAN_INTERVAL=20        # seconds between scans (only used when running locally)
DRY_RUN=true            # set to false to place real orders
